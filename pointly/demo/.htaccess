# ── Pointly PWA cache headers ──────────────────────────────────────────────

<IfModule mod_headers.c>

  # HTML pages — NEVER cache, always fetch fresh from server
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Service worker, manifest, registerSW — never cache
  <FilesMatch "(^sw\.js$|^workbox-[^.]+\.js$|^registerSW\.js$|\.webmanifest$)">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hashed JS/CSS assets — cache forever (content hash guarantees freshness)
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

</IfModule>

# SPA fallback — serve index.html for all routes under /demo/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /demo/

  # Skip existing files/directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Send everything to index.html
  RewriteRule ^ index.html [L]
</IfModule>
